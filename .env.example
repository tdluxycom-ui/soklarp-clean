PORT=59617
# Set strong values before creating a fresh local database. Never commit .env.
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-long-password
INITIAL_PLAYER_PASSWORD=replace-with-a-unique-long-password
# 24 hours in milliseconds
SESSION_TTL_MS=86400000
# Optional SQLite path (primary store). JSON at data/database.json is kept as backup.
# SQLITE_PATH=
